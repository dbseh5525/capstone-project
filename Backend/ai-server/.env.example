# .env로 복사한 뒤 값을 채우세요. .env는 git에 커밋하지 마세요.

GEMINI_API_KEY=your-key-here

# aistudio.google.com에서 무료로 발급 가능. gemini-3.6-flash(기본값) 등 원하는 모델로 변경 가능
GEMINI_MODEL=gemini-3.6-flash

# 파인튜닝한 감정 분류 모델 경로.
# 로컬 디렉터리 경로 또는 Hugging Face Hub repo id(예: your-org/emotion-klue-bert) 모두 가능.
EMOTION_MODEL_PATH=klue/bert-base

# 콤마로 구분된 허용 origin 목록. 로컬 개발 중에는 * 로 둬도 무방.
CORS_ORIGINS=*
